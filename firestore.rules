rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'skim460725@gmail.com';
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());

      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == friendId);
      }
    }

    // Lets a signed-out client resolve "username" -> email before calling Firebase
    // Auth's email/password sign-in, which has no native username support. Only
    // exact-ID lookups are allowed (no `list`), so a username must already be known
    // to read it — this can't be used to enumerate accounts.
    match /usernameEmails/{username} {
      allow get: if true;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow read, update: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid ||
         request.auth.uid == resource.data.toUid);
    }

    match /studySessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        // Joining a friend's session from the Friends tab "Sync" button: the
        // joiner (not the doc owner) sets syncPartnerUid on the host's doc.
        // Only allowed when the host opted in, isn't already paired, and the
        // write touches nothing but that one field.
        (
          resource.data.allowSync == true &&
          !('syncPartnerUid' in resource.data) &&
          request.resource.data.syncPartnerUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncPartnerUid'])
        )
      );
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }

    match /cafePrograms/{cafeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /rewardAccounts/{accountId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/cafePrograms/$(request.resource.data.cafeId)).data.ownerUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /cafeAnnouncements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/cafePrograms/$(request.resource.data.cafeId)).data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (get(/databases/$(database)/documents/cafePrograms/$(resource.data.cafeId)).data.ownerUid == request.auth.uid ||
         isAdmin());
    }

    match /menuItems/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/cafePrograms/$(request.resource.data.cafeId)).data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (get(/databases/$(database)/documents/cafePrograms/$(resource.data.cafeId)).data.ownerUid == request.auth.uid ||
         isAdmin());
    }

    // "Can't find a cafe?" submissions from the check-in search — the
    // submitter can read/create their own, only the admin can see the full
    // queue, decide, or delete.
    match /cafeRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.submittedByUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.submittedByUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /cafeReviews/{reviewId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    // Menu photos any user can contribute (separate from the merchant-owned
    // menuImageUrls on cafePrograms, which only the cafe owner can edit).
    match /menuPhotos/{photoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    match /studyNotes/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Per-pair "synced sessions together" counters, keyed by the two
    // participants' sorted uids. Either participant can read/write their own pair.
    // Membership is checked against the pairId itself ("uidA_uidB", sorted)
    // rather than resource.data — the doc may not exist yet the first time
    // two people complete a synced session, and resource.data on a
    // non-existent doc throws in rules (evaluates to permission denied).
    match /pairStats/{pairId} {
      allow read: if request.auth != null && request.auth.uid in pairId.split('_');
      allow create, update: if request.auth != null &&
        request.auth.uid in pairId.split('_') &&
        request.auth.uid in request.resource.data.uids;
    }

    // Group study plans. Any member can update the shared doc (there's no
    // backend, so each member self-evaluates their own progress and records
    // it here) — trust-based, same as the friend-tagging pattern elsewhere.
    match /studyPlans/{planId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.memberUids;
      allow update: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Scheduled "study with me at 4pm" invites between two people.
    match /studyInvites/{inviteId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow delete: if request.auth != null && request.auth.uid == resource.data.fromUid;
    }

    // Shared Coffee Buddy photos — feeds the Home "Buddy adventures" strip
    // (self + friends) and the poster's own profile. Read is open to any
    // signed-in user since the Home feed needs to read posts by friend uids;
    // only the poster can write their own posts.
    match /buddyPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /buddyPostComments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /nudges/{nudgeId} {
      allow read: if request.auth != null &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.toUid == request.auth.uid;
    }
  }
}
